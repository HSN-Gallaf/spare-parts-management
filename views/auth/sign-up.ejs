<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/style.css" />
    
    
    <title>Sign Up</title>
  </head>
  <body>
      <div class="main-section">
      <div class="left-side">
        <img src="/main/sign-img.jpg" alt="Sign Up Image">
      </div>

      <div class="right-side">
        <div class="title-section">
        <h1>Create a new account</h1>
        <p class="login-redirect">Already Have An Account? <a href="/auth/sign-in">Login</a></p>
        </div>

        <form action="/auth/sign-up" method="post">
          <label for="username">Username:</label>
          <input type="text" name="username" class="form-control" placeholder="Username"/>

          <div id="password-lable">
            <label for="password">Password:</label>
            <label for="confirmPassword">Confirm Password:</label>
          </div>

          <div id="password-section">
            <input type="password" name="password" class="form-control" placeholder="Password"/>
            <input type="password" name="confirmPassword" class="form-control" placeholder="Password Confirm"/>
          </div>


          <label for="role">Chose A User Type:</label>
          <select class="form-select" name="role" id="role">
            <option value="" disabled selected>Chose Type...</option>
            <% for (let role of roles) { %>
                <option value="<%= role  %>"><%= role  %></option>
            <% } %>
          </select>

          <button type="submit" class="btn btn-primary">Sign up</button>
        </form>

        <div class="footer-section">
          <hr class="line">
          <p class="login-redirect">Go Back To <a href="/">Home Page</a></p>
        </div>
      </div>

      
    </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>


    
  </body>
</html>
