<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav>
        <div class="left-nav">
            <a href="/" id="nav-brand"><strong>Spare Part Shop</strong></a>
            <% if (user){ %>
                <button>
                <a  href="/products">Spare Parts</a>
                </button>
            <% if (user.role === 'admin') { %>
                <button>
                <a href="/categories">Categories</a>
                </button>
            <% } %>
        </div>

        <div class="right-nav">
            <a href="/cart"><img id="cart-icon" src="/main/cart-icon.png" alt="Cart Button"></a>
            <a href="/auth/sign-out"><img id="logout-icon" src="/main/logout-icon.png" alt="Logout Button"></a>
        </div>
        <% } else{ %>
            <a href="/auth/sign-up">Sign up</a>
            <a href="/auth/sign-in">Login</a>
        <% } %>
    </nav>
  </body>
</html>
