<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav>
    <!-- Left Section: Always contains the brand, and conditionally contains links -->
    <div class="left-nav">
        <a href="/" id="nav-brand"><strong>Spare Part Shop</strong></a>
        <% if (user){ %>
            <a href="/products"><button class="nav-btn">Spare Parts</button></a>
            <% if (user.role === 'admin') { %>
                <a href="/categories"><button class="nav-btn">Categories</button></a>
            <% } %>
        <% } %>
    </div>

    <!-- Right Section: Dynamically handles either action state -->
    <div class="right-nav">
        <% if (user){ %>
            <a href="/cart"><img id="cart-icon" src="/main/cart-icon.png" alt="Cart Button"></a>
            <a href="/auth/sign-out"><img id="logout-icon" src="/main/logout-icon.png" alt="Logout Button"></a>
        <% } else { %>
            <div class="signin-nav">
                <a href="/auth/sign-in" id="signin-a"><button class="nav-btn">Login</button></a>
            </div>
        <% } %>
    </div>
</nav>

  </body>
</html>
