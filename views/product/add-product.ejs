<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add New Spare Part</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <h1>Add New Spare Part</h1>
    <form action="/products" method="POST">
      <label for="name">Name:</label>
      <input name="name" id="name" type="text" /><br /><br />

      <label for="price">Price:</label>
      <input name="price" id="price" type="text" /><br /><br />

      <label for="imageUrl">Image:</label>
      <input name="imageUrl" id="imageUrl" type="file" /><br /><br />

      <label for="categoryId">Category:</label>
      <select name="categoryId" id="categoryId">
         <option value="" disabled selected>Select an option...</option>
        <% for (let category of categories) { %>
            <option value="<%= category._id  %>"><%= category.name  %></option>
        <% } %>
      </select>

      <button type="submit">Add Spare Part</button>
    </form>
  </body>
</html>
