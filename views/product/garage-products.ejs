
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    />
    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />

    <link rel="stylesheet" href="/css/style.css" />

    <title>My Products</title>
</head>

<body>

    <%- include('../partials/navbar') %>

        <div class="my-products-container">

          <div class="my-products-header">
            <div>
                <h1>My Products</h1>
                <p>Manage your listed spare parts.</p>
            </div>

            <button class="btn btn-primary add-product-btn" data-bs-toggle="modal" data-bs-target="#exampleModal">
                    + Add New Product
            </button>
          </div>

        <div class="my-products-grid">

            <% if (myProducts.length > 0) { %>
                <% for (let product of myProducts) { %>
                    <div class="my-product-card">
                        <img
                            src="/products/<%=product.imageUrl %>"
                            alt="<%= product.name %>"
                        />
                        <h3><%= product.name %></h3>

                        <p class="product-price">
                            <%= product.price %>BD
                        </p>

                        <p class="product-category">
                            Category:
                            <%= product.categoryId.name %>
                        </p>

                        <div class="product-actions">

                            <a href="/products/<%= product._id %>" class="btn btn-primary">
                                Edit
                            </a>

                            <form
                                action="/products/<%= product._id %>?_method=DELETE"
                                method="POST"
                            >
                                <button
                                    type="submit"
                                    class="btn btn-danger"
                                >
                                    Delete
                                </button>
                            </form>

                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <p class="no-products ">
                    You haven't added any products yet.
                </p>
            <% } %>
        </div>
    </div>

    <%- include('../partials/add-product') %>

    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
