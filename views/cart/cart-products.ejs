<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart Spare Parts</title>
</head>
<body>
    <h1>Cart Spare Parts</h1>

    <% for (let product of cart.cartProducts) { %>
        <%=product.name  %>
        <form action="/cart/<%= product._id %>?_method=DELETE" method="POST">
            <button type="submit">Remove From Cart</button>
        </form>
    <% } %>
</body>
</html>